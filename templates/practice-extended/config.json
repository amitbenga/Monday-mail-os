{
  "id": "practice-extended",
  "name": "קבוצות תרגול — תרגול בתוך קורס מורחב",
  "subject": "מייל פתיחה למועלמונית — {{course_name}}",
  "bodyFile": "body.txt",
  "params": {
    "course_manager": { "label": "מנהלת קורס",          "required": true,  "monday": "course_manager" },
    "course_name":    { "label": "שם הקורס (שם פריט)",  "required": true,  "monday": "name" },
    "start_date":     { "label": "תאריך פתיחה",          "required": true,  "monday": "start_date" },
    "day":            { "label": "יום",                  "required": true,  "monday": "day" },
    "hours":          { "label": "שעות",                 "required": true,  "monday": "hours" },
    "address":        { "label": "כתובת",                "required": true,  "monday": "address",       "requiredWhen": "is_frontal" },
    "contact_name":   { "label": "איש קשר",              "required": true,  "monday": "contact_name" },
    "contact_phone":  { "label": "טלפון איש קשר",        "required": true,  "monday": "contact_phone" },
    "syllabus":       { "label": "סילבוס",               "required": true,  "monday": "syllabus" },
    "attendance":     { "label": "נוכחות",               "required": true,  "monday": "attendance_sheet" }
  },
  "flags": {
    "lesson_format": {
      "label": "פורמט המפגש",
      "monday": "lesson_format",
      "values": ["frontal", "zoom"]
    }
  },
  "conditions": {
    "is_frontal": "lesson_format == 'frontal'",
    "is_zoom":    "lesson_format == 'zoom'"
  }
}
