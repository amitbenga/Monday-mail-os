# --- Session (must be at least 32 characters, random) ---
SESSION_PASSWORD=replace_with_a_long_random_string_min_32_chars

# --- Monday.com ---
# A personal API token with read access to the relevant board.
MONDAY_API_TOKEN=

# Logical-key -> Monday column id mapping.
# The mapper looks up env vars named MONDAY_COL_<UPPER_SNAKE_KEY>.
# Logical keys used by the templates:
#   course_manager, start_date, day, hours, address, zoom_account,
#   contact_name, contact_phone, syllabus, attendance_sheet,
#   teaching_payment, travel_payment, zoom_link, zoom_password,
#   recordings_folder, lesson_format, student_phone, student_email,
#   student_notebook
#
# Find the column id in Monday: open the column menu -> "Customize column" -> column id.
MONDAY_COL_COURSE_MANAGER=
MONDAY_COL_START_DATE=
MONDAY_COL_DAY=
MONDAY_COL_HOURS=
MONDAY_COL_ADDRESS=
MONDAY_COL_ZOOM_ACCOUNT=text99
MONDAY_COL_CONTACT_NAME=
MONDAY_COL_CONTACT_PHONE=
MONDAY_COL_SYLLABUS=
MONDAY_COL_ATTENDANCE_SHEET=
MONDAY_COL_TEACHING_PAYMENT=
MONDAY_COL_TRAVEL_PAYMENT=
MONDAY_COL_ZOOM_LINK=
MONDAY_COL_ZOOM_PASSWORD=
MONDAY_COL_RECORDINGS_FOLDER=
MONDAY_COL_LESSON_FORMAT=
MONDAY_COL_STUDENT_PHONE=
MONDAY_COL_STUDENT_EMAIL=
MONDAY_COL_STUDENT_NOTEBOOK=

# --- Google OAuth (Gmail draft scope) ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
